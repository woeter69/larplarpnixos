/*****----- Configuration -----*****/
configuration {
    show-icons:                 true;
    drun-display-format:        "{name}";
}

/*****----- Global Properties -----*****/
* {
    font:                        "JetBrains Mono Nerd Font 9";
    background:                  #11111b;
    background-alt:              #313244;
    foreground:                  #eff1f5;
    selected:                    #cba6f7;
}

/*****----- Main Window -----*****/
window {
    fullscreen:                  false;
    location:                    center;
    anchor:                      center;
    border-radius:               12px;
    padding:                     10px;
    background-color:            transparent;
}

/*****----- Main Layout -----*****/
mainbox {
    border-radius:               12px;
    spacing:                     0px;
    orientation:                 vertical;
    children:                    [ "listbox" ];
    background-color:            transparent;
}

listbox {
    spacing:                     0px;
    orientation:                 vertical;
    children:                    [ "listview" ];
    background-color:            transparent;
}

/*****----- Listview: Icon Grid -----*****/
listview {
    columns:                     5;
    lines:                       3;
    layout:                      vertical;
    fixed-columns:               false;
    fixed-height:                false;
    dynamic:                     true;
    spacing:                     10px;
    padding:                     10px;
    border-radius:               12px;
    background-color:            #1e1e2e;
}

/*****----- Element Styling -----*****/
element {
    padding:                     4px;
    border-radius:               8px;
    background-color:            transparent;
    horizontal-align:            0.5;
    vertical-align:              0.5;
    cursor:                      pointer;
}
element selected.normal {
    background-color:            @selected;
}
element-icon {
    size:                        159px;
    border-radius:               6px;
    background-color:            transparent;
    vertical-align:              0.5;
    padding:                     2px;
}
element-text {
    text-color:                  transparent;
    background-color:            transparent;
    padding:                     0px;
    font:                        "JetBrains Mono Nerd Font 0";
}
